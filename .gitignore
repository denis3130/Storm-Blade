assets/meshy/history.json
assets/meshy/hero/anims/
assets/meshy/hero/hero_rigged.fbx
assets/meshy/*/_meshy_source/anims/

# Unreal: cartelle generate (si ricreano da sole)
unreal/**/Binaries/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/DerivedDataCache/
unreal/**/.vs/
unreal/**/*.sln
unreal/**/*.VC.db

# Progetto Unreal in StormBlade/ (scelta di Denis, 3/11/2026)
StormBlade/Binaries/
StormBlade/Intermediate/
StormBlade/Saved/
StormBlade/DerivedDataCache/
StormBlade/.vs/
StormBlade/*.sln
StormBlade/*.slnx
StormBlade/*.VC.db
